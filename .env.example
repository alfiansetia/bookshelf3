APP_NAME="Rak Buku"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Lokal: sqlite (default), file di database/database.sqlite.
DB_CONNECTION=sqlite
# Produksi (Docker): pakai MySQL shared yang sudah jalan di network `app-network`.
# DB_HOST WAJIB nama service mysql di network itu, BUKAN 127.0.0.1/localhost —
# container app tidak bisa menjangkau MySQL lewat loopback-nya sendiri.
# DB_CONNECTION=mysql
# DB_HOST=mysql-shared
# DB_PORT=3306
# DB_DATABASE=bookshelf
# DB_USERNAME=bookshelf
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Cloudflare R2 untuk sampul & avatar (opsional) ---
# Isi R2_* dulu, baru ubah BOOKSHELF_IMAGE_DISK menjadi r2.
# R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_URL: https://pub-<hash>.r2.dev atau domain sendiri
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_REGION=auto
BOOKSHELF_IMAGE_DISK=public

VITE_APP_NAME="${APP_NAME}"

# --- Login dengan Google (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
